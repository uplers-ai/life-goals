rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Wall photos and videos. The page shrinks photos and caps videos at 20 MB.
    match /wall/{file} {
      allow read;
      allow create: if request.resource.size < 20 * 1024 * 1024
                    && request.resource.contentType.matches('(image|video)/.*');
      allow delete;
    }
  }
}
